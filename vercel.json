{
  "buildCommand": "npm run build:lib && npm run build:app && cd website && npm run build",
  "outputDirectory": "website/out",
  "installCommand": "npm install",
  "framework": null,
  "redirects": [
    {
      "source": "/",
      "destination": "/en/",
      "permanent": true
    },
    { "source": "/early", "has": [{ "type": "header", "key": "accept-language", "value": "(?:pt|PT).*" }], "destination": "/pt-br/early/", "permanent": false },
    { "source": "/early", "has": [{ "type": "header", "key": "accept-language", "value": "(?:es|ES).*" }], "destination": "/es/early/", "permanent": false },
    { "source": "/early", "has": [{ "type": "header", "key": "accept-language", "value": "(?:fr|FR).*" }], "destination": "/fr/early/", "permanent": false },
    { "source": "/early", "has": [{ "type": "header", "key": "accept-language", "value": "(?:de|DE).*" }], "destination": "/de/early/", "permanent": false },
    { "source": "/early", "has": [{ "type": "header", "key": "accept-language", "value": "(?:it|IT).*" }], "destination": "/it/early/", "permanent": false },
    { "source": "/early", "has": [{ "type": "header", "key": "accept-language", "value": "(?:zh|ZH).*" }], "destination": "/zh-hans/early/", "permanent": false },
    { "source": "/early", "destination": "/en/early/", "permanent": false }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/compresso/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/compresso/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/compresso" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/compresso/:locale(es|fr|de|it|pt-br|zh-hans)", "destination": "/compresso/:locale/index.html" },
    { "source": "/compresso/:locale(es|fr|de|it|pt-br|zh-hans)/", "destination": "/compresso/:locale/index.html" }
  ]
}
