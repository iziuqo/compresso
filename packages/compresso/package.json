{
  "name": "compresso.js",
  "version": "0.2.0",
  "description": "Tiny image optimizer that runs entirely in the browser — a ~2 KB core with zero required dependencies. Compress, resize, and convert images (HEIC/HEIF input supported) on the client side — no server needed.",
  "type": "module",
  "main": "dist/compresso.cjs",
  "module": "dist/compresso.mjs",
  "unpkg": "dist/compresso.umd.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/compresso.mjs",
      "require": "./dist/compresso.cjs",
      "types": "./types/index.d.ts"
    }
  },
  "files": [
    "dist",
    "types",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "image",
    "compression",
    "resize",
    "optimize",
    "browser",
    "client-side",
    "webp",
    "avif",
    "jpeg",
    "png",
    "heic",
    "heif",
    "canvas",
    "file-upload",
    "image-processing",
    "zero-dependency",
    "lightweight",
    "accessibility"
  ],
  "author": "Izaias Cavalcanti",
  "license": "MIT WITH Commons-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iziuqo/compresso.git"
  },
  "homepage": "https://compresso.izaias.xyz",
  "bugs": {
    "url": "https://github.com/iziuqo/compresso/issues"
  },
  "devDependencies": {
    "rollup": "^4.28.0",
    "@rollup/plugin-terser": "^0.4.4"
  },
  "optionalDependencies": {
    "heic-to": "^1.5.2"
  },
  "sideEffects": false
}
