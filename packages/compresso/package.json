{
  "name": "compresso.js",
  "version": "1.0.0",
  "description": "Tiny image optimizer that runs entirely in the browser — a 3.6 KB core with zero required dependencies. Compress, resize, and convert images (HEIC/HEIF input supported), with parallel Web Worker batching, on the client side — no server needed.",
  "type": "module",
  "main": "dist/compresso.cjs",
  "module": "dist/compresso.mjs",
  "unpkg": "dist/compresso.umd.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/compresso.mjs",
      "require": "./dist/compresso.cjs",
      "types": "./types/index.d.ts"
    },
    "./pool": {
      "import": "./dist/compresso.pool.mjs",
      "types": "./types/pool.d.ts"
    }
  },
  "files": [
    "dist",
    "types",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:browser": "vitest run --project browser",
    "size": "size-limit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "image",
    "compression",
    "resize",
    "optimize",
    "browser",
    "client-side",
    "webp",
    "avif",
    "jpeg",
    "png",
    "heic",
    "heif",
    "canvas",
    "file-upload",
    "image-processing",
    "zero-dependency",
    "lightweight",
    "accessibility",
    "image-compressor",
    "compress-image",
    "image-optimizer",
    "image-resize",
    "typescript",
    "exif",
    "web-worker",
    "webworker",
    "offscreencanvas",
    "batch-processing",
    "parallel"
  ],
  "author": "Izaias Cavalcanti",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iziuqo/compresso.git"
  },
  "homepage": "https://compresso.izaias.xyz",
  "bugs": {
    "url": "https://github.com/iziuqo/compresso/issues"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@size-limit/file": "^13.0.3",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "playwright": "^1.62.1",
    "rollup": "^4.28.0",
    "size-limit": "^13.0.3",
    "vitest": "^4.1.10"
  },
  "optionalDependencies": {
    "heic-to": "^1.5.2"
  },
  "sideEffects": false,
  "size-limit": [
    {
      "name": "main entry (import { compress } from 'compresso.js')",
      "path": "dist/compresso.mjs",
      "limit": "4 KB",
      "gzip": true
    },
    {
      "name": "pool entry (import { createPool } from 'compresso.js/pool')",
      "path": "dist/compresso.pool.mjs",
      "limit": "5.25 KB",
      "gzip": true
    },
    {
      "name": "worker script (dist/worker.js, loaded by the pool, not imported directly)",
      "path": "dist/worker.js",
      "limit": "4 KB",
      "gzip": true
    }
  ]
}
