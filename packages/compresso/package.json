{
  "name": "compresso.js",
  "version": "1.1.0-beta.2",
  "description": "Small image optimizer that runs entirely in the browser: compress, resize and convert images before upload, with no server. About 5 KB gzipped with no runtime dependencies in its core, HEIC/HEIF input through an optional decoder, never-bigger output when it picks the format, and parallel Web Worker batching.",
  "type": "module",
  "main": "dist/compresso.cjs",
  "module": "dist/compresso.mjs",
  "unpkg": "dist/compresso.umd.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/compresso.mjs",
      "require": "./dist/compresso.cjs",
      "types": "./types/index.d.ts"
    },
    "./pool": {
      "import": "./dist/compresso.pool.mjs",
      "types": "./types/pool.d.ts"
    },
    "./plan": {
      "import": "./dist/compresso.plan.mjs",
      "require": "./dist/compresso.plan.cjs",
      "types": "./types/plan.d.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "types",
    "pool",
    "plan",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:browser": "vitest run --project browser",
    "test:dist": "vitest run --project dist",
    "test:bundlers": "vitest run --project bundlers",
    "test:lab": "vitest run --project lab",
    "test:coverage": "vitest run --coverage --project unit --project \"browser (chromium)\"",
    "test:types": "tsc --noEmit -p test/types && node scripts/extract-readme-snippets.mjs && tsc --noEmit -p test/types/readme",
    "generate:benchmark-corpus": "node scripts/generate-benchmark-corpus.mjs",
    "size": "size-limit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "image",
    "compression",
    "resize",
    "optimize",
    "browser",
    "client-side",
    "webp",
    "avif",
    "jpeg",
    "png",
    "heic",
    "heif",
    "canvas",
    "file-upload",
    "upload",
    "max-file-size",
    "heic-converter",
    "image-processing",
    "lightweight",
    "accessibility",
    "image-compressor",
    "compress-image",
    "image-optimizer",
    "image-resize",
    "typescript",
    "web-worker",
    "webworker",
    "offscreencanvas",
    "batch-processing",
    "parallel"
  ],
  "author": "Izaias Cavalcanti",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iziuqo/compresso.git"
  },
  "homepage": "https://compresso.izaias.xyz",
  "bugs": {
    "url": "https://github.com/iziuqo/compresso/issues"
  },
  "devDependencies": {
    "@rollup/plugin-terser": "^1.0.2",
    "@size-limit/file": "^14.3.0",
    "@vitest/browser": "^5.1.1",
    "@vitest/browser-playwright": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "playwright": "^1.65.1",
    "rollup": "^4.68.3",
    "size-limit": "^14.3.0",
    "typescript": "^5.9.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "optionalDependencies": {
    "heic-to": "^1.5.2"
  },
  "sideEffects": false,
  "size-limit": [
    {
      "name": "main entry (import { compress } from 'compresso.js')",
      "path": "dist/compresso.mjs",
      "limit": "5.25 KB",
      "gzip": true
    },
    {
      "name": "pool entry (import { createPool } from 'compresso.js/pool')",
      "path": "dist/compresso.pool.mjs",
      "limit": "6.5 KB",
      "gzip": true
    },
    {
      "name": "worker script (dist/worker.js, loaded by the pool, not imported directly)",
      "path": "dist/worker.js",
      "limit": "5.25 KB",
      "gzip": true
    },
    {
      "name": "plan entry, photo and video (import { planPhoto, planVideo } from 'compresso.js/plan')",
      "path": "dist/compresso.plan.mjs",
      "limit": "2 KB",
      "gzip": true
    }
  ]
}
