{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "website",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "-w", "website"],
      "port": 3001,
      "autoPort": true
    },
    {
      "name": "website-prod",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["--yes", "serve@latest", "website/out", "-l", "3005"],
      "port": 3005,
      "autoPort": true
    }
  ]
}
