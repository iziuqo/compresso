{
  "name": "compresso-mobile",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "expo": "~58.0.20",
    "expo-constants": "~58.0.13",
    "expo-file-system": "~58.0.11",
    "expo-font": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.17",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.14",
    "expo-localization": "~58.0.5",
    "expo-router": "~58.0.27",
    "expo-sharing": "~58.0.20",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "export:web": "expo export --platform web",
    "icons": "python3 scripts/make-icons.py",
    "store:metadata": "node scripts/store-metadata.mjs",
    "store:photos": "python3 store/make-sample-photos.py store/out/photos",
    "store:capture": "node store/capture.mjs store/out/photos store/out/raw",
    "store:compose": "node store/compose.mjs store/out/raw store/out/images",
    "store:record": "node store/record.mjs store/out/photos store/out/rec",
    "store:reel": "node store/reel.mjs store/out/rec store/out/video"
  },
  "private": true
}
