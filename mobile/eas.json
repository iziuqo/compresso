{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "simulator": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json",
        "track": "alpha",
        "releaseStatus": "draft"
      },
      "ios": {
        "ascAppId": "6829326032",
        "ascApiKeyPath": "./asc-api-key.p8",
        "ascApiKeyIssuerId": "30f4d669-f59c-47dc-a446-6348b3939a61",
        "ascApiKeyId": "9PZ2VT3F23",
        "metadataPath": "./store.config.js"
      }
    }
  }
}
