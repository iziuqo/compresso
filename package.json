{
  "name": "compresso-monorepo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build:lib",
    "build:lib": "npm run build -w packages/compresso",
    "dev": "npm run dev -w packages/compresso",
    "test:lib": "npm run test -w packages/compresso",
    "test:lib:browser": "npm run test:browser -w packages/compresso",
    "test:types": "npm run test:types -w packages/compresso",
    "size:lib": "npm run size -w packages/compresso"
  }
}
